# Ignore folders generated by Bundler.
# NOTE: these are anchored with a leading slash on purpose. A bare `vendor/`
# also matched assets/vendor/, which silently kept the self-hosted Bootstrap
# and webfonts out of the repo and would have shipped an unstyled site.
/.bundle/
/vendor/
Gemfile.lock

.DS_Store
